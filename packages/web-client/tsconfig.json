{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": true,
    "composite": false,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "paths": { "@pi-studio-ui/*": ["./src/*"] }
