{
  "name": "@av-pi-studio/cli",
  "version": "0.0.80",
  "bin": {
    "pi-studio": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && chmod +x dist/cli.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@av-pi-studio/client": "^0.0.80",
    "@av-pi-studio/protocol": "^0.0.80",
    "@av-pi-studio/relay": "^0.0.80",
    "@av-pi-studio/server": "^0.0.80",
    "@av-pi-studio/web-client": "^0.0.80",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@inquirer/prompts": "^8.5.2",
    "bcryptjs": "^3.0.3",
    "commander": "^14.0.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/qrcode": "^1.5.6"
  }
}
