{
  "name": "@av-pi-studio/relay",
  "version": "0.0.8",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pi-studio-relay": "dist/relay-main.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/relay-server.d.ts",
      "default": "./dist/relay-server.js"
    }
  },
  "scripts": {
    "build": "tsc -b && chmod +x dist/relay-main.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
