{
  "name": "@av-pi-studio/workbench",
  "version": "0.0.117",
  "description": "The Pi-Studio client application as a library: every feature, its stores and its shell regions, for web and desktop shells",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avatsaev/pi-studio.git",
    "directory": "packages/workbench"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@av-pi-studio/client": "^0.0.117",
    "@av-pi-studio/protocol": "^0.0.117",
    "@av-pi-studio/ui-library": "^0.0.117"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "vite": "^6.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
