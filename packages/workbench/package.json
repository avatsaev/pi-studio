{
  "name": "@av-pi-studio/workbench",
  "version": "0.0.122",
  "description": "The Pi-Studio client application as a library: every feature, its stores and its shell regions, for web and desktop shells",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avatsaev/pi-studio.git",
    "directory": "packages/workbench"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -b tsconfig.json tsconfig.vite.json && node scripts/check-dist.mjs",
    "check-dist": "node scripts/check-dist.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@av-pi-studio/client": "^0.0.122",
    "@av-pi-studio/protocol": "^0.0.122",
    "@av-pi-studio/ui-library": "^0.0.122",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@molviewer/core": "^0.4.6",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.5",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "katex": "^0.18.4",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.16.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react-markdown": "^9.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^1.29.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tweetnacl": "^1.0.3",
    "vite": "^6.4.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
