# The daemon host of the live update check: a plain Node image, a normal user (uid 1000, NOT root:
# root can write every folder and would hide the not-writable scenarios) and a user-owned npm prefix,
# the layout `npm config set prefix ~/.npm-global` gives a developer. `ps` (procps) is what
# tree-kill and the check's process lists use; git is what the daemon's projects need.
FROM node:22-bookworm-slim

ARG REGISTRY
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates procps \
 && rm -rf /var/lib/apt/lists/*

USER node
ENV PATH=/home/node/.npm-global/bin:$PATH
RUN mkdir -p /home/node/.npm-global \
 && printf 'registry=%s\nprefix=/home/node/.npm-global\nupdate-notifier=false\nfund=false\naudit=false\n' "$REGISTRY" > /home/node/.npmrc
WORKDIR /home/node
