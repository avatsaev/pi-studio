{
  "name": "@av-pi-studio/root",
  "private": true,
  "description": "Pi-Studio — self-hosted local-first system for running and controlling the Pi AI coding agent",
  "license": "AGPL-3.0",
  "workspaces": [
    "packages/protocol",
    "packages/client",
    "packages/server",
    "packages/cli",
    "packages/relay",
    "packages/web-client",
    "packages/ui-library",
    "packages/workbench",
    "packages/ui-gallery",
    "desktop/apps/pistudiodesktop"
  ],
  "type": "module",
  "scripts": {
    "lint": "oxlint --ignore-pattern \"desktop/**\"",
    "lint:fix": "oxlint --fix --ignore-pattern \"desktop/**\"",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:protocol": "tsc -b packages/protocol",
    "build:relay": "node packages/relay/scripts/gen-version.mjs && tsc -b packages/relay && chmod +x packages/relay/dist/relay-main.js",
    "build:client": "tsc -b packages/client",
    "build:server": "node packages/server/scripts/gen-version.mjs && tsc -b packages/server && chmod +x packages/server/dist/daemon/main.js",
    "build:web-client": "npm run build:web -w packages/web-client",
    "build:ui-library": "npm run build -w packages/ui-library",
    "build:workbench": "npm run build -w packages/workbench",
    "build:cli": "node packages/cli/scripts/gen-version.mjs && tsc -b packages/cli && chmod +x packages/cli/dist/cli.js",
    "build": "npm run build:protocol && npm run build:relay && npm run build:client && npm run build:ui-library && npm run build:workbench && npm run build:server && npm run build:web-client && npm run build:ui-gallery && npm run build:cli",
    "start": "npm run build:server && node packages/server/dist/daemon/main.js",
    "start:server": "node packages/server/dist/daemon/main.js",
    "dev:daemon": "npm run build:server && node packages/server/dist/daemon/dev-main.js",
    "clean": "tsc -b --clean && rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "publish": "bash scripts/publish.sh",
    "docker:publish": "bash scripts/docker-publish.sh",
    "docker:deploy": "bash scripts/dokploy-deploy.sh",
    "release": "bash scripts/release.sh",
    "version:set": "node scripts/set-version.mjs",
    "build:ui-gallery": "npm run build -w packages/ui-gallery",
    "build:binary": "node scripts/build-binary.mjs",
    "test:binary": "node scripts/binary-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun": "1.4.5",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=22.20"
  }
}
