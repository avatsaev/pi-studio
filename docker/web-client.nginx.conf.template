# nginx config for the Pi-Studio web UI (static SPA + optional daemon WS proxy).
# Rendered at container start by the nginx image's envsubst mechanism.
# ${PI_STUDIO_DAEMON_UPSTREAM} defaults to the compose daemon (set in the Dockerfile).

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen       8080;
  server_name  _;
  root         /usr/share/nginx/html;
  index        index.html;

  # Optional same-origin WebSocket proxy to the daemon. Lets the browser connect
  # to the daemon through this server's origin (host field: ws://<web-host>/daemon-ws)
  # instead of exposing the daemon port directly. Using a variable for the upstream
  # (plus a resolver) defers name resolution to request time, so nginx still boots
  # when the daemon isn't reachable and this proxy is simply unused.
  location /daemon-ws {
    resolver            127.0.0.11 ipv6=off valid=10s;
    set $daemon_upstream ${PI_STUDIO_DAEMON_UPSTREAM};
    proxy_pass          http://$daemon_upstream;
    proxy_http_version  1.1;
    proxy_set_header    Upgrade $http_upgrade;
    proxy_set_header    Connection $connection_upgrade;
    proxy_set_header    Host $host;
    proxy_read_timeout  86400s;
    proxy_send_timeout  86400s;
  }

  # SPA fallback: unknown routes serve index.html so client-side routing works.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Long-cache hashed assets; never cache the HTML entry.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }
  location = /index.html {
    add_header Cache-Control "no-cache";
  }
}
