# nginx config for the Pi-Studio web UI: a static SPA only. The browser reaches the daemon through
# the relay with a pairing link, never through this server.

server {
  listen       8080;
  server_name  _;
  root         /usr/share/nginx/html;
  index        index.html;

  # SPA fallback: unknown routes serve index.html so client-side routing works.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Long-cache hashed assets; never cache the HTML entry.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }
  location = /index.html {
    add_header Cache-Control "no-cache";
  }
}
