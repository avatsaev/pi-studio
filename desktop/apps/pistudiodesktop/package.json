{
  "name": "pistudiodesktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc -b",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "vitest run",
    "tauri": "tauri",
    "app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "bundle": "tauri build",
    "snapshot": "node scripts/snapshot.mjs",
    "snapshot:install": "playwright install chromium"
  },
  "dependencies": {
    "@av-pi-studio/ui-library": "*",
    "@av-pi-studio/workbench": "*",
    "@tauri-apps/api": "^2.12.4",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
