{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Studio",
  "identifier": "com.avatsaev.pi-studio",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pi Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": ["'self'", "'wasm-unsafe-eval'"],
        "worker-src": ["'self'", "blob:"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:", "blob:"],
        "media-src": ["'self'", "blob:"],
        "font-src": ["'self'", "data:"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "ws://127.0.0.1:*", "blob:"],
        "frame-src": ["pi-preview:"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExQ0YxRUVFQ0IwQTgwQ0EKUldUS2dBckw3aDdQb1ZPditLWlg5NVg0NHJZV0U0V1cwOTlGSXF0eWRCRkp1NmpUSDRudFZIRXEK",
      "endpoints": ["https://github.com/avatsaev/pi-studio/releases/download/desktop-updates/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
