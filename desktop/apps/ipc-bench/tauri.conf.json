{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Studio IPC Bench",
  "identifier": "com.avatsaev.pi-studio.ipc-bench",
  "build": {
    "frontendDist": "page"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pi Studio IPC Bench",
        "width": 900,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "ws://127.0.0.1:*"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/icon.ico"]
  }
}
